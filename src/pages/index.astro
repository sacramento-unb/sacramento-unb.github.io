---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { Image } from "astro:assets";
import territory from "../assets/territorio-inteligencia.png";
---

<BaseLayout title="Vitor Sacramento — Data engineering and geospatial intelligence" description="Portfolio of Vitor Sacramento: data engineering, geospatial AI, environmental intelligence and software systems.">
  <div class="shell">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow">Territory / data / applied intelligence</p>
        <h1 id="intro-title">From territory to <em>applied intelligence.</em></h1>
        <p class="hero-intro">I’m Vitor Sacramento. I connect geoscience, data engineering and AI to understand complex systems and build tools for clearer decisions.</p>
        <div class="actions"><a class="button" href="/projects/">Explore projects <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">Meet Vitor <span aria-hidden="true">→</span></a></div>
        <p class="hero-footnote">Geoscience · Data systems · Applied AI · Software</p>
      </div>
      <figure class="hero-art">
        <Image class="hero-art__image" src={territory} widths={[480, 800, 1200]} sizes="(max-width: 600px) 100vw, 50vw" width={1200} format="webp" quality={80} alt="Abstract brand illustration: terrain contours converge into a structured data grid. This is not a geographic dataset." loading="eager" fetchpriority="high" />
        <figcaption class="hero-art__signature"><img src="/brand/simbolo-negativo.svg" width="64" height="64" alt="" /><span>Coordinates of synthesis<br />Science / territory / intelligence</span></figcaption>
      </figure>
    </section>
    <section class="section home-intro">
      <div class="section-label">01 / Point of view</div>
      <div class="split-copy"><h2>Real questions connect the disciplines.</h2><div><p class="lead">A spatial observation, a time series or a software workflow starts with the same question: what needs to be understood, and what evidence would support a decision?</p><a class="text-link" href="/expertise/">Explore my areas of practice <span aria-hidden="true">→</span></a></div></div>
    </section>
    <section class="section home-work">
      <div class="section-heading"><div><p class="section-label">02 / Selected work</p><h2>Ideas put into code.</h2></div><a class="text-link" href="/projects/">All case studies <span aria-hidden="true">↗</span></a></div>
      <div class="work-list">
        {projects.map((project, index) => <a class="work-row" href={`/projects/${project.slug}/`}>
          <span class="work-row__number">0{index + 1}</span>
          <span class="work-row__title"><strong>{project.title}</strong><small>{project.summary}</small></span>
          <span class="work-row__meta">{project.domain}<br />{project.status}</span>
          <span class="work-row__arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </section>
    <section class="section home-principles">
      <p class="section-label">03 / How I work</p><h2>Method, clarity and responsibility.</h2>
      <div class="principles"><article><span>01</span><h3>Understand the context</h3><p>Frame the question, spatial and temporal scales, and the constraints that shape a useful solution.</p></article><article><span>02</span><h3>Make the method visible</h3><p>Connect models and software to readable documentation and evidence that can be inspected.</p></article><article><span>03</span><h3>Communicate the limits</h3><p>Describe uncertainty, validation boundaries and what still needs to be tested.</p></article></div>
    </section>
    <section class="home-contact">
      <p class="eyebrow">Have a hard data problem?</p><h2>Start with the <em>question.</em></h2><a class="button" href="/contact/">Open a conversation <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</BaseLayout>
