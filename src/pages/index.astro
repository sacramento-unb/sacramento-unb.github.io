---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Vitor Sacramento — Data engineering and geospatial intelligence" description="Portfolio of Vitor Sacramento: data engineering, geospatial AI, environmental intelligence and software systems.">
  <div class="shell">
    <section class="hero hero--personal">
      <div class="hero-copy">
        <p class="eyebrow">A working portfolio / 2026</p>
        <h1>I make complex data <em>legible.</em></h1>
        <p class="hero-intro">Vitor Sacramento builds evidence-led tools at the intersection of data engineering, geospatial systems and applied AI.</p>
        <div class="actions"><a class="button" href="/projects/">See selected work <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">How I work <span aria-hidden="true">↓</span></a></div>
        <p class="hero-footnote">Four public projects / each one tied to code, context and limits.</p>
      </div>
      <div class="hero-art" role="img" aria-label="Abstract field notes visual with the initials VS">
        <span class="hero-art__label">Field notes<br />01—04</span>
        <span class="hero-art__stamp">VS<br /><small>STUDIO / SYSTEMS</small></span>
        <span class="hero-art__ring hero-art__ring--one"></span>
        <span class="hero-art__ring hero-art__ring--two"></span>
        <span class="hero-art__ring hero-art__ring--three"></span>
        <span class="hero-art__axis hero-art__axis--x"></span>
        <span class="hero-art__axis hero-art__axis--y"></span>
        <p class="hero-art__caption">signals / place / people</p>
      </div>
    </section>
    <section class="section home-intro">
      <div class="section-label">01 / Point of view</div>
      <div class="split-copy"><h2>Not a list of tools. A record of how the work gets made.</h2><div><p class="lead">The interesting part is rarely the stack. It is the translation between messy signals, real constraints and a system someone can trust.</p><a class="text-link" href="/about/">Read the longer version <span aria-hidden="true">↗</span></a></div></div>
    </section>
    <section class="section home-work">
      <div class="section-heading"><div class="section-label">02 / Selected work</div><a class="text-link" href="/projects/">All case studies <span aria-hidden="true">↗</span></a></div>
      <div class="work-list">
        {projects.map((project, index) => <a class="work-row" href={`/projects/${project.slug}/`}>
          <span class="work-row__number">0{index + 1}</span>
          <span class="work-row__title"><strong>{project.title}</strong><small>{project.summary}</small></span>
          <span class="work-row__meta">{project.domain}<br />{project.status}</span>
          <span class="work-row__arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </section>
    <section class="section home-principles">
      <div class="section-label">03 / Publication standard</div>
      <div class="principles"><article><span>01</span><h3>Context first</h3><p>Every case study starts with the problem, not the technology.</p></article><article><span>02</span><h3>Evidence over theatre</h3><p>Claims stay close to the repository, tests and observable output.</p></article><article><span>03</span><h3>Limits included</h3><p>Unverified runtime behavior is named clearly instead of polished away.</p></article></div>
    </section>
    <section class="home-contact">
      <p class="eyebrow">Have a hard data problem?</p><h2>Start with the <em>question.</em></h2><a class="button" href="/contact/">Open a conversation <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</BaseLayout>
