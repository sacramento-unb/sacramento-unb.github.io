import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Expertise — Vitor Sacramento" description="Technical focus across data, geospatial systems, applied AI and software engineering.">
  <div class="shell"><header class="page-head"><p class="eyebrow">Expertise</p><h1>Different disciplines. A connected practice.</h1><p class="lead">From a spatial observation to a data model, an API or an explanation someone can use. Each area contributes to the same process of understanding a real problem.</p></header>
    <section class="grid expertise-grid" aria-label="Areas of practice">
      <article class="card"><span class="index">01 / Territory</span><h2>Geospatial intelligence</h2><p>Spatial analysis, remote sensing, WebGIS and territorial modeling. Environmental and agroclimatic questions need context across both space and time.</p></article>
      <article class="card"><span class="index">02 / Structure</span><h2>Data engineering and governance</h2><p>Architecture, integration, quality controls, databases and APIs. Making analytical work repeatable starts with explicit data definitions and reliable flows.</p></article>
      <article class="card"><span class="index">03 / Patterns</span><h2>Data science and applied AI</h2><p>Analytical modeling, machine learning, computer vision and time series, with validation boundaries stated clearly.</p><a class="text-link" href="/projects/obs-eye-contact/">Explore the vision experiment →</a></article>
      <article class="card"><span class="index">04 / Systems</span><h2>Software and automation</h2><p>APIs, local tools and web applications that connect a model or workflow to practical use.</p><a class="text-link" href="/projects/editor-inteligente-video/">Explore the media workflow →</a></article>
    </section>
    <section class="section split-copy"><h2>Technical communication makes the system usable.</h2><div><p class="lead">Documentation, teaching and visualization make assumptions and relationships understandable. They belong alongside implementation.</p><a class="text-link" href="/writing/">Writing and teaching →</a></div></section>
  </div>
</BaseLayout>
