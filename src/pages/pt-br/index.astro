---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import territory from "../../assets/territorio-inteligencia.png";
import { projects } from "../../data/projects";
const summaries = ["Visão computacional para redirecionamento do olhar em fluxos de vídeo no Linux.", "Revisão e renderização não destrutiva de vídeo, com aprovação humana.", "Processamento de áudio e microfone virtual com perfis locais no Linux.", "PWA com estado local e persistência criptografada opcional no navegador."];
---
<BaseLayout lang="pt-BR" title="Vitor Sacramento — território, dados e inteligência aplicada" description="Geociências, inteligência geoespacial, engenharia de dados e IA aplicada. Conheça a abordagem de Vitor Sacramento e seus projetos públicos.">
  <div class="shell">
    <section class="hero" aria-labelledby="intro-title"><div><p class="eyebrow">Território / dados / inteligência aplicada</p><h1 id="intro-title">Do território à <em>inteligência aplicada.</em></h1><p class="hero-intro">Sou Vitor Sacramento. Integro geociências, engenharia de dados e IA para compreender sistemas complexos e construir ferramentas que apoiem decisões mais claras.</p><div class="actions"><a class="button" href="#projetos">Conhecer os projetos →</a><a class="text-link" href="/about/" lang="en">Perfil profissional (em inglês) →</a></div><p class="hero-footnote">Geociências · Sistemas de dados · IA aplicada · Software</p></div>
      <figure class="hero-art"><Image class="hero-art__image" src={territory} widths={[480, 800, 1200]} sizes="(max-width: 600px) 100vw, 50vw" width={1200} format="webp" quality={80} alt="Ilustração abstrata da marca: curvas de território convergem para uma grade de dados. Não representa dados geográficos reais." loading="eager" fetchpriority="high" /><figcaption class="hero-art__signature"><img src="/brand/simbolo-negativo.svg" width="64" height="64" alt="" /><span>Coordenadas de síntese<br />Ciência / território / inteligência</span></figcaption></figure>
    </section>
    <section class="section"><p class="section-label">01 / Trajetória e abordagem</p><div class="split-copy"><h2>O mundo físico e o digital fazem parte do mesmo problema.</h2><div><p class="lead">Sou geólogo formado pela Universidade de Brasília. Minha atuação conecta inteligência geoespacial, arquitetura e governança de dados, modelagem, software e comunicação técnica.</p><p>O trabalho começa com perguntas bem formuladas e termina com métodos e sistemas que outras pessoas conseguem compreender, avaliar e usar.</p><a class="text-link" href="/expertise/" lang="en">Especialidades (em inglês) →</a></div></div></section>
    <section class="section" id="projetos"><p class="section-label">02 / Projetos selecionados</p><h2>Ideias colocadas em código.</h2><p class="lead">Experimentos pessoais com arquitetura, verificações realizadas e limitações explícitas. Os estudos de caso completos estão em inglês.</p><div class="work-list">{projects.map((project, index) => <a class="work-row" href={`/projects/${project.slug}/`}><span class="work-row__number">0{index + 1}</span><span class="work-row__title"><strong>{project.title}</strong><small>{summaries[index]}</small></span><span class="work-row__meta">Experimental<br />Estudo em inglês</span><span aria-hidden="true">→</span></a>)}</div></section>
    <section class="section"><p class="section-label">03 / Método</p><h2>Rigor, clareza e responsabilidade.</h2><div class="principles"><article><h3>Compreender o contexto</h3><p>Formular a pergunta, reconhecer escalas e identificar as restrições que orientam a solução.</p></article><article><h3>Tornar o método visível</h3><p>Conectar modelos e software a documentação legível e evidências que possam ser verificadas.</p></article><article><h3>Comunicar os limites</h3><p>Explicitar incertezas, fronteiras da validação e aquilo que ainda precisa ser testado.</p></article></div></section>
    <section class="home-contact"><p class="eyebrow">Tem um problema real para discutir?</p><h2>Comece pela <em>pergunta.</em></h2><p>GitHub é o canal público disponível para conhecer o código e entrar em contato.</p><a class="button" href="https://github.com/sacramento-unb">Perfil no GitHub ↗</a></section>
  </div>
</BaseLayout>
