---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — Vitor Sacramento`} description={project.summary}>
  <article class="shell"><header class="page-head"><p class="eyebrow">Case study · {project.domain}</p><h1>{project.title}</h1><p class="lead">{project.summary}</p></header><div class="prose section"><h2>Publication status</h2><p>This case study is generated only from an audited, approved allowlist entry.</p><h2>Technologies</h2><p>{project.technologies.join(", ")}</p><p><a href={project.repositoryUrl}>View the public repository</a></p></div></article>
</BaseLayout>
