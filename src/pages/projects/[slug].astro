---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — Vitor Sacramento`} description={project.summary}>
  <article class="shell case-study"><header class="page-head"><p class="eyebrow">Case study / {project.domain} / {project.status}</p><h1>{project.title}</h1><p class="lead">{project.summary}</p><div class="case-meta"><span>Verified implementation</span><a href={project.repositoryUrl}>Public repository ↗</a></div></header><div class="prose section">
    <p class="case-intro">A closer look at the question, the system and the limits that stay visible.</p>
    <h2>Context</h2><p>{project.context}</p>
    <h2>Problem</h2><p>{project.problem}</p>
    <h2>My role</h2><p>{project.role}</p>
    <h2>Technical approach</h2><p>{project.technicalApproach}</p>
    <h2>Architecture</h2><p>{project.architecture}</p>
    <h2>Implementation</h2><p>{project.implementation}</p>
    <h2>Challenges</h2><p>{project.challenges}</p>
    <h2>Results</h2><p>{project.results}</p>
    <h2>Technologies</h2><p>{project.technologies.join(", ")}</p>
    <h2>Lessons learned</h2><p>{project.lessons}</p>
    <p><a class="button" href={project.repositoryUrl}>View the public repository <span aria-hidden="true">↗</span></a></p>
  </div></article>
</BaseLayout>
