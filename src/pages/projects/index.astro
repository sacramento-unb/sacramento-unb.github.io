---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
const domains = ["all", "data", "ai", "geospatial", "software"];
---
<BaseLayout title="Projects — Vitor Sacramento" description="Verified projects in data engineering, geospatial intelligence, AI and software.">
  <div class="shell project-index"><header class="page-head"><p class="eyebrow">Selected work / {projects.length.toString().padStart(2, "0")} case studies</p><h1>Projects with evidence behind them.</h1><p class="lead">A public index of systems built around data, place and applied intelligence. Each entry keeps verified implementation separate from runtime claims that still need validation.</p></header>
    <div class="filters" aria-label="Filter projects">{domains.map((domain) => <button type="button" data-filter={domain} aria-pressed={domain === "all"}>{domain}</button>)}</div>
    <section class="grid project-grid" id="project-grid">{projects.map((project, index) => <article class="card project-card" data-domain={project.domain}><div class="project-card__header"><span class="index">0{index + 1}</span><span class="project-card__domain">{project.domain} / {project.status}</span></div><h2><a href={`/projects/${project.slug}/`}>{project.title}</a></h2><p>{project.summary}</p><p class="project-card__link"><a href={`/projects/${project.slug}/`}>Read the case study <span aria-hidden="true">↗</span></a></p></article>)}</section>
    {projects.length === 0 && <p class="empty-state">No project has been approved for publication yet. The repository audit and rights review remain local.</p>}
  </div>
  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      document.querySelectorAll<HTMLElement>("[data-domain]").forEach((card) => { card.hidden = filter !== "all" && card.dataset.domain !== filter; });
    }));
  </script>
</BaseLayout>
