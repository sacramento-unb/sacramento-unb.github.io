---
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  lang?: "en" | "pt-BR";
};

const { title, description, lang = "en" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1ede4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <script is:inline>
      const saved = localStorage.getItem("theme");
      document.documentElement.dataset.theme = saved || "light";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="Vitor Sacramento home">
          <span class="brand-mark">VS</span>
          <span class="brand-name">Vitor Sacramento</span>
        </a>
        <p class="header-kicker">Data / space / intelligence</p>
        <nav aria-label="Primary navigation">
          <a href="/projects/">Work</a>
          <a href="/expertise/">Practice</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Toggle color theme">◐</button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="footer-signoff"><span class="brand-mark">VS</span><p>Evidence-led work for complex systems.</p></div>
      <div><a href="https://github.com/sacramento-unb">GitHub</a> <a href="/pt-br/" lang="pt-BR">Português</a></div>
    </footer>
    <script is:inline>
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>
