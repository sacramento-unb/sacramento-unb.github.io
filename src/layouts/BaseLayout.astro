---
import "../styles/global.css";
import "@fontsource-variable/noto-sans/wght.css";
import "@fontsource/noto-sans-mono/latin-400.css";
import "@fontsource/noto-serif/latin-400.css";
import sansFont from "@fontsource-variable/noto-sans/files/noto-sans-latin-wght-normal.woff2?url";

type Props = {
  title: string;
  description: string;
  lang?: "en" | "pt-BR";
  noindex?: boolean;
};

const { title, description, lang = "en", noindex = false } = Astro.props;
const canonical = new URL(noindex ? "/404.html" : Astro.url.pathname, Astro.site);
const portuguese = lang === "pt-BR";
const navigation = [
  { href: "/projects/", label: portuguese ? "Projetos" : "Projects" },
  { href: "/expertise/", label: portuguese ? "Especialidades" : "Expertise" },
  { href: "/about/", label: portuguese ? "Sobre" : "About" },
  { href: "/contact/", label: portuguese ? "Contato" : "Contact" },
];
const shareImage = new URL("/brand/social-card.png", Astro.site);
const structuredData = { "@context": "https://schema.org", "@type": "Person", name: "Vitor Sacramento", url: Astro.site?.href, jobTitle: "Geologist, data scientist and data engineer", sameAs: ["https://github.com/sacramento-unb", "https://www.linkedin.com/in/vitor-sacramento-50a337134/"], address: { "@type": "PostalAddress", addressLocality: "Brasília", addressRegion: "DF", addressCountry: "BR" }, knowsLanguage: ["pt-BR", "en"], description: "Geoscience, geospatial intelligence, data engineering and applied AI." };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b3440" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Vitor Sacramento" />
    <meta property="og:locale" content={portuguese ? "pt_BR" : "en_US"} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vitor Sacramento — territory, data and applied intelligence" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content="Vitor Sacramento — territory, data and applied intelligence" />
    {(["/", "/pt-br/"].includes(Astro.url.pathname)) && <>
      <link rel="alternate" hreflang="en" href={new URL("/", Astro.site)} />
      <link rel="alternate" hreflang="pt-BR" href={new URL("/pt-br/", Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
    </>}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    <title>{title}</title>
    <script is:inline>
      let theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      try { const saved = localStorage.getItem("theme"); if (saved === "light" || saved === "dark") theme = saved; } catch {}
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{portuguese ? "Ir para o conteúdo" : "Skip to content"}</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={portuguese ? "/pt-br/" : "/"} aria-label={portuguese ? "Vitor Sacramento, início" : "Vitor Sacramento home"}>
          <span class="brand-symbol" aria-hidden="true"><img class="brand-symbol--light" src="/brand/simbolo.svg" width="44" height="44" alt="" /><img class="brand-symbol--dark" src="/brand/simbolo-negativo.svg" width="44" height="44" alt="" /></span>
          <span class="brand-name">Vitor Sacramento</span>
        </a>
        <nav aria-label={portuguese ? "Navegação principal" : "Primary navigation"}>
          {navigation.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname === href || (href === "/projects/" && Astro.url.pathname.startsWith(href)) ? "page" : undefined}>{label}</a>)}
        </nav>
        <button class="theme-toggle" type="button" aria-label={portuguese ? "Tema escuro" : "Dark theme"} aria-pressed="false" hidden><span aria-hidden="true">◐</span></button>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-signoff"><img class="footer-symbol" src="/brand/simbolo-negativo.svg" width="48" height="48" alt="" /><p>Vitor Sacramento<br /><span>{portuguese ? "Território, dados e inteligência aplicada." : "Territory, data and applied intelligence."}</span></p></div>
        <nav aria-label={portuguese ? "Links do rodapé" : "Footer links"}>
          <a href="/writing/" lang="en">Writing &amp; teaching</a>
          <a href="https://github.com/sacramento-unb">GitHub</a>
          <a href={portuguese ? "/" : "/pt-br/"} lang={portuguese ? "en" : "pt-BR"}>{portuguese ? "English" : "Português"}</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      const toggle = document.querySelector(".theme-toggle");
      if (toggle) {
        toggle.hidden = false;
        const sync = () => toggle.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
        sync();
        toggle.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch {}
          sync();
        });
      }
    </script>
  </body>
</html>
